#!/usr/bin/env bash
#
# Starts one or more deployments in dev mode against one Svelte dev server,
# on ports taken from PORT so several worktrees can run at the same time.
#
# Run `bin/dev --help` for the commands.

set -eo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

help() {
  cat <<USAGE
Starts one or more deployments in dev mode against one Svelte dev server,
on ports taken from PORT so several worktrees can run at the same time.

Usage: $0 [TARGET...] [ARGS...]

Targets, any number of them, \`web\` when none:
  web       The web server (\`cargo run -p app_web\`), with the dev server
            sending /api to it.
  desktop   The desktop app (\`cargo tauri dev\`).
  ios       The iOS app in a simulator (\`cargo tauri ios dev\`), after
            \`cargo tauri ios init\` the first time. Needs Xcode, see README.md.
  android   The Android app in an emulator (\`cargo tauri android dev\`),
            after \`cargo tauri android init\` the first time. Needs Android
            Studio, see README.md.
  ports     Print the ports the targets would use, without starting anything.
  help      Show this help. Also -h and --help.

ARGS, whatever follows the targets, go to the mobile app's dev command:
\`bin/dev ios "iPhone 16"\` picks that simulator, booted first so the
install does not race its start. Closing the dev server (Ctrl-C) stops
every target.

The Svelte dev server is started once, here, and every target loads its
pages from it, so the desktop and the iOS app can run side by side on one
server. A Tauri target then builds with an empty \`beforeDevCommand\`, which
the Tauri CLI skips. Two Tauri targets compile in turn: Cargo locks the
workspace's target/ while it builds, so the second waits for the first.

Ports:
  PORT unset   The web server on 4000 and the Svelte dev server on 1420, as
               the README says. When another program holds one of them, a
               warning, then 4010 and 5010; an error when those are taken too.
  PORT set     The web server on PORT and the Svelte dev server on
               PORT + 1000, so consecutive ports never meet; an error when
               either is taken.
  Storage      Garage on the web server's port + 2000 to + 2003, see
               \`bin/storage --help\`. Code Reviewer sets a distinct PORT in each
               session's tmux environment, so each worktree's apps run on
               ports of their own.

Examples:
  bin/dev                          # the web, on 4000 and 1420
  bin/dev desktop                  # the desktop app, its pages on 1420
  PORT=4003 bin/dev desktop ios    # both apps, their pages on 5003
USAGE
}

fail() {
  echo "$0: $*" >&2
  exit 1
}

DEFAULT_WEB_PORT=4000
DEFAULT_VITE_PORT=1420
FALLBACK_PORT=4010

# The targets are the leading arguments; the rest go to the mobile dev command.
targets=()
only_print_ports=false
while [ $# -gt 0 ]; do
  case "$1" in
    web|desktop|ios|android) targets+=("$1"); shift ;;
    ports) only_print_ports=true; shift ;;
    help|-h|--help) help; exit 0 ;;
    -*) fail "unknown option '$1'; run \`$0 --help\`" ;;
    *) break ;;
  esac
done
if [ ${#targets[@]} -eq 0 ]; then
  if [ $# -gt 0 ]; then
    fail "unknown target '$1'; run \`$0 --help\`"
  fi
  targets=(web)
fi

starts_web=false
for target in "${targets[@]}"; do
  [ "$target" = web ] && starts_web=true
done

# The programs listening on a port, by name, or nothing when it is free.
list_port_listeners() {
  lsof -nP -iTCP:"$1" -sTCP:LISTEN -Fc 2>/dev/null | sed -n 's/^c//p' | sort -u | tr '\n' ' '
}

# The ports this run listens on that another program holds, with the
# programs, one per line. The web port and Garage's only when the web
# target runs: the apps alone send to a web server started elsewhere.
list_taken_ports() {
  local port listeners storage_port=$((web_port + 2000)) ports=("$vite_port")
  if [ "$starts_web" = true ]; then
    ports+=("$web_port")
    command -v garage > /dev/null &&
      ports+=("$storage_port" $((storage_port + 1)) $((storage_port + 2)) $((storage_port + 3)))
  fi
  for port in "${ports[@]}"; do
    listeners=$(list_port_listeners "$port")
    [ -z "$listeners" ] || echo "  $port, held by ${listeners% }"
  done
}

case "${PORT:-}" in
  '')
    web_port=$DEFAULT_WEB_PORT
    vite_port=$DEFAULT_VITE_PORT
    taken=$(list_taken_ports)
    if [ -n "$taken" ]; then
      web_port=$FALLBACK_PORT
      vite_port=$((FALLBACK_PORT + 1000))
      echo "bin/dev: warning: the default ports are taken:" >&2
      echo "$taken" >&2
      echo "bin/dev: trying $web_port and $vite_port; set PORT to pick, like \`PORT=4020 $0 ...\`" >&2
      taken=$(list_taken_ports)
      if [ -n "$taken" ]; then
        fail "the fallback ports are taken too:
$taken
Set PORT to free ones, like \`PORT=4020 $0 ...\` (the pages on PORT + 1000)"
      fi
    fi
    ;;
  *[!0-9]*)
    fail "PORT must be a number, got '$PORT'"
    ;;
  *)
    web_port="$PORT"
    vite_port=$((PORT + 1000))
    if [ "$web_port" -lt 1024 ] || [ "$vite_port" -gt 65535 ]; then
      fail "PORT must be between 1024 and 64535, got '$web_port'"
    fi
    taken=$(list_taken_ports)
    if [ -n "$taken" ]; then
      fail "the ports from PORT=$PORT are taken:
$taken
Set PORT to free ones (the pages on PORT + 1000)"
    fi
    ;;
esac

storage_port=$((web_port + 2000))

if [ "$only_print_ports" = true ]; then
  echo "Web server  http://localhost:$web_port"
  echo "Svelte dev  http://localhost:$vite_port"
  echo "Storage     http://127.0.0.1:$storage_port, files on $((storage_port + 2))"
  exit 0
fi

# The Tauri CLI opens the Simulator app on the device and installs the
# app at once, without waiting for the device to boot, so a run from a
# simulator that was shut down fails at the install with "Unable to
# lookup in current state: Shutdown". Booting the named simulator first,
# and waiting for it, is what makes `bin/dev ios "iPhone 16"` work cold;
# with no name the CLI picks or prompts, and nothing is booted here. Of
# several simulators with the name, the one on the newest iOS.
boot_simulator() {
  local name="$1" udid
  [ -n "$name" ] || return 0
  udid=$(xcrun simctl list devices available -j 2>/dev/null | python3 -c '
import json, sys
name = sys.argv[1]
found = []
for runtime, devices in json.load(sys.stdin)["devices"].items():
    for device in devices:
        if device["name"] == name:
            found.append((runtime, device["udid"]))
print(sorted(found)[-1][1] if found else "")' "$name")
  if [ -z "$udid" ]; then
    echo "bin/dev: no simulator named '$name'; the Tauri CLI lists the ones there are" >&2
    return 0
  fi
  echo "bin/dev: booting the simulator $name ($udid)"
  xcrun simctl bootstatus "$udid" -b > /dev/null
}

pids=()
# Stops every target and the dev server when one of them is closed, or this
# script is interrupted, and waits for them, so a run started right after
# finds the ports free.
stop_all() {
  trap - EXIT INT TERM
  for pid in ${pids[@]+"${pids[@]}"}; do
    pkill -P "$pid" 2>/dev/null || true
    kill "$pid" 2>/dev/null || true
  done
  for pid in ${pids[@]+"${pids[@]}"}; do
    wait "$pid" 2>/dev/null || true
  done
}
trap stop_all EXIT INT TERM

if [ ! -d "$ROOT/svelte/node_modules" ]; then
  (cd "$ROOT/svelte" && pnpm install)
fi

# The Svelte dev server, listening on every address so a simulator or a
# phone on the network reaches it too, sending /api to the web server.
echo "bin/dev: the pages on http://localhost:$vite_port"
(cd "$ROOT/svelte" && WEB_SERVER_URL="http://localhost:$web_port" exec pnpm dev --port "$vite_port" --host) &
pids+=($!)

# Where an app sends the browser to sign in: the pages on the dev server,
# which send /api to the web server, so `bin/dev web desktop` is the pair.
sign_in_url="http://localhost:$vite_port/accounts/sign-in"

# The Tauri CLI's config override: the pages from the dev server above, no
# dev server of the CLI's own, and the two URLs the app needs, under the
# starter-pack entry of plugins, since a phone build gets no environment
# from here (tauri/src/server_urls.rs).
tauri_config="{\"build\":{\"devUrl\":\"http://localhost:$vite_port\",\"beforeDevCommand\":\"\"},\"plugins\":{\"starter-pack\":{\"syncServerUrl\":\"http://localhost:$web_port\",\"browserSignInUrl\":\"$sign_in_url\"}}}"

# Up once set up, its key written, and its S3 API answering; a failure
# when bin/storage exits first or is not up in 30 seconds.
wait_for_storage() {
  local pid=$1 tries=0
  until STORAGE_PORT="$storage_port" "$ROOT/bin/storage" env > /dev/null 2>&1 &&
    curl -s -o /dev/null "http://127.0.0.1:$storage_port/"; do
    kill -0 "$pid" 2>/dev/null || fail "bin/storage stopped before Garage was up; see its output above"
    tries=$((tries + 1))
    [ "$tries" -lt 150 ] || fail "Garage was not up after 30 seconds; see its output above"
    sleep 0.2
  done
}

# Garage, the web server's bucket, when it is installed; without it the
# server runs with uploads off. Its STORAGE_* variables go to the server
# once it is set up and answering.
storage_env=()
if [ "$starts_web" = true ]; then
  if command -v garage > /dev/null; then
    (STORAGE_PORT="$storage_port" exec "$ROOT/bin/storage" start) &
    storage_pid=$!
    pids+=("$storage_pid")
    wait_for_storage "$storage_pid"
    while IFS= read -r line; do
      storage_env+=("$line")
    done < <(STORAGE_PORT="$storage_port" "$ROOT/bin/storage" env)
  else
    echo "bin/dev: warning: garage is not installed, so uploads are off; \`brew install garage\`" >&2
  fi
fi

for target in "${targets[@]}"; do
  case "$target" in
    web)
      echo "bin/dev: the web server on http://localhost:$web_port"
      (cd "$ROOT" && exec env ${storage_env[@]+"${storage_env[@]}"} PORT="$web_port" cargo run -p app_web) &
      pids+=($!)
      ;;
    desktop)
      echo "bin/dev: the desktop app"
      (cd "$ROOT/tauri" && exec cargo tauri dev --config "$tauri_config") &
      pids+=($!)
      ;;
    ios|android)
      echo "bin/dev: the $target app"
      (
        cd "$ROOT/tauri"
        case "$target" in
          ios)
            [ -d gen/apple ] || cargo tauri ios init
            boot_simulator "${1:-}"
            ;;
          android) [ -d gen/android ] || cargo tauri android init ;;
        esac
        exec cargo tauri "$target" dev --config "$tauri_config" ${1+"$@"}
      ) &
      pids+=($!)
      ;;
  esac
done

# Over when the first target or the dev server stops. The bash macOS ships,
# 3.2, has no `wait -n`, so this looks in on them.
while true; do
  for pid in "${pids[@]}"; do
    kill -0 "$pid" 2>/dev/null || exit 0
  done
  sleep 1
done
