{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Starter Pack",
  "version": "0.1.0",
  "identifier": "com.starterpack.app",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../svelte"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../svelte"
    },
    "frontendDist": "../svelte/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Starter Pack",
        "url": "/home",
        "width": 1040,
        "height": 820,
        "minWidth": 400,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 16
        },
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "starter-pack": {
      "syncServerUrl": "http://localhost:4000",
      "browserSignInUrl": ""
    }
  }
}
