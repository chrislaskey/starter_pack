{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: the status page, the synced pages (communities, posts, tags, profile) and the tmux example page. It reads the connection and sync state, opens the Phoenix window and quick search, sends API requests, reads and writes the synced data, and drags the window by its title bar strip",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-get-connection-status",
    "allow-open-phoenix",
    "allow-api-request",
    "allow-log-out",
    "allow-get-tmux-example-settings",
    "allow-get-tmux-status",
    "allow-create-tmux-session",
    "allow-open-tmux-session",
    "allow-get-quick-search-status",
    "allow-request-accessibility-access",
    "allow-open-quick-search",
    "allow-get-profile",
    "allow-get-communities-page",
    "allow-write-post",
    "allow-edit-post",
    "allow-sync-now",
    "allow-get-sync-status",
    "allow-resolve-conflict",
    "allow-get-community-page",
    "allow-leave-community",
    "allow-remove-post-from-community",
    "allow-create-comment",
    "allow-delete-comment",
    "allow-get-posts-page",
    "allow-show-post-form",
    "allow-change-post-form",
    "allow-delete-post",
    "allow-add-link",
    "allow-remove-link",
    "allow-tag-post",
    "allow-untag-post",
    "allow-get-tags-page",
    "allow-create-tag",
    "allow-rename-tag",
    "allow-delete-tag",
    "allow-get-profile-page",
    "allow-edit-profile",
    "core:window:allow-start-dragging"
  ]
}
