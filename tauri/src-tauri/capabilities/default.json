{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The local status window: it reads the connection state, opens the Phoenix window and sends API requests, the tmux example page and the quick search status",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-connection-status",
    "allow-open-phoenix",
    "allow-api-request",
    "allow-log-out",
    "allow-get-tmux-example-settings",
    "allow-get-tmux-status",
    "allow-create-tmux-session",
    "allow-open-tmux-session",
    "allow-get-quick-search-status",
    "allow-request-accessibility-access",
    "allow-open-quick-search"
  ]
}
